{
  "name": "agent-working-memory",
  "version": "0.15.6",
  "description": "Persistent, local-first memory for AI agents. Selective by design: filters what's worth keeping, links what's related, and says nothing when it doesn't know. SQLite + ONNX, no cloud, no API keys.",
  "keywords": [
    "ai-agents",
    "agent-memory",
    "memory",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "local-first",
    "sqlite",
    "onnx",
    "retrieval",
    "cognitive-architecture",
    "act-r",
    "hebbian",
    "embeddings",
    "reranker",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "awm": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "pack:mcpb": "node scripts/build-mcpb.mjs --pack",
    "prepublishOnly": "npm run build && npm run build:plugin && npm run build:mcpb && npm run check:release",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "mcp": "tsx src/mcp.ts",
    "test:mcp": "tsx tests/mcp-smoke.ts",
    "test:self": "tsx tests/self-test/runner.ts",
    "test:workday": "tsx tests/workday-eval/runner.ts",
    "test:locomo": "tsx tests/locomo-eval/runner.ts",
    "test:tokens": "tsx tests/token-savings/runner.ts",
    "test:realworld": "tsx tests/realworld-eval/runner.ts",
    "test:ab": "tsx tests/ab-test/runner.ts",
    "test:sleep": "tsx tests/sleep-cycle/runner.ts",
    "test:stress": "tsx tests/stress-test/runner.ts",
    "test:edge": "tsx tests/edge-cases/runner.ts",
    "test:pilot": "tsx tests/pilot-metrics/runner.ts",
    "test:perf": "tsx tests/perf-test/runner.ts",
    "eval": "tsx tests/eval/run.ts",
    "eval:generate": "tsx tests/eval/generate.ts",
    "test:all": "vitest run && tsx tests/mcp-smoke.ts",
    "check:release": "node scripts/check-release.mjs",
    "bench": "node scripts/bench-current.mjs",
    "test:docker": "bash scripts/docker-release-test.sh",
    "test:linux": "bash scripts/docker-release-test.sh linux",
    "test:desktop": "bash scripts/docker-release-test.sh desktop"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0",
  "files": [
    "dist/",
    "src/",
    "plugin/",
    ".claude-plugin/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@electric-sql/pglite-pgvector": "^0.0.7",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@toon-format/toon": "^2.3.0",
    "better-sqlite3": "^12.6.2",
    "fastify": "^5.8.2",
    "pg": "^8.13.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompleteIdeas/agent-working-memory.git"
  },
  "homepage": "https://github.com/CompleteIdeas/agent-working-memory#readme",
  "bugs": {
    "url": "https://github.com/CompleteIdeas/agent-working-memory/issues"
  }
}
